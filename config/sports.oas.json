{
  "openapi": "3.1.0",
  "info": {
    "title": "Sports MCP Server",
    "version": "1.0.0",
    "description": "Second MCP server (/sports/mcp): multi-sport scores, standings and news, Formula 1, and game-day weather. The MLB server lives in routes.oas.json at /mcp."
  },
  "paths": {
    "/sports/scoreboard": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "operationId": "getLeagueScoreboard",
        "summary": "Get scores for a league",
        "description": "Returns games with live/final scores, start times, venue city and broadcasts for a non-MLB league (NFL, NBA, WNBA, NHL, MLS, English Premier League, college football, men's college basketball). Omit date for the current slate of games.",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "scoreboard",
            "module": "$import(./modules/sports-espn-handler)"
          },
          "policies": {
            "inbound": [
              "mcp-jwt-auth",
              "log-tool-call",
              "rate-limit-tool-call"
            ]
          },
          "mcp": {
            "type": "tool",
            "name": "getLeagueScoreboard",
            "description": "Returns games with live/final scores, start times, venue city and broadcasts for a non-MLB league (NFL, NBA, WNBA, NHL, MLS, English Premier League, college football, men's college basketball). Omit date for the current slate of games."
          }
        },
        "parameters": [
          {
            "name": "league",
            "in": "query",
            "required": true,
            "description": "League to look up.",
            "schema": {
              "type": "string",
              "enum": [
                "nfl",
                "nba",
                "wnba",
                "nhl",
                "mls",
                "epl",
                "ncaaf",
                "ncaab"
              ]
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Date in YYYYMMDD format, e.g. 20261109. Omit for the current games.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/sports/standings": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "operationId": "getLeagueStandings",
        "summary": "Get standings for a league",
        "description": "Returns current standings by conference/division for a non-MLB pro league (NFL, NBA, WNBA, NHL, MLS, English Premier League).",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "standings",
            "module": "$import(./modules/sports-espn-handler)"
          },
          "policies": {
            "inbound": [
              "mcp-jwt-auth",
              "log-tool-call",
              "rate-limit-tool-call"
            ]
          },
          "mcp": {
            "type": "tool",
            "name": "getLeagueStandings",
            "description": "Returns current standings by conference/division for a non-MLB pro league (NFL, NBA, WNBA, NHL, MLS, English Premier League)."
          }
        },
        "parameters": [
          {
            "name": "league",
            "in": "query",
            "required": true,
            "description": "League to look up.",
            "schema": {
              "type": "string",
              "enum": [
                "nfl",
                "nba",
                "wnba",
                "nhl",
                "mls",
                "epl"
              ]
            }
          }
        ]
      }
    },
    "/sports/news": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "operationId": "getLeagueNews",
        "summary": "Get news for a league",
        "description": "Returns the latest headlines for a non-MLB league (NFL, NBA, WNBA, NHL, MLS, English Premier League, college football, men's college basketball).",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "news",
            "module": "$import(./modules/sports-espn-handler)"
          },
          "policies": {
            "inbound": [
              "mcp-jwt-auth",
              "log-tool-call",
              "rate-limit-tool-call"
            ]
          },
          "mcp": {
            "type": "tool",
            "name": "getLeagueNews",
            "description": "Returns the latest headlines for a non-MLB league (NFL, NBA, WNBA, NHL, MLS, English Premier League, college football, men's college basketball)."
          }
        },
        "parameters": [
          {
            "name": "league",
            "in": "query",
            "required": true,
            "description": "League to look up.",
            "schema": {
              "type": "string",
              "enum": [
                "nfl",
                "nba",
                "wnba",
                "nhl",
                "mls",
                "epl",
                "ncaaf",
                "ncaab"
              ]
            }
          }
        ]
      }
    },
    "/sports/f1/standings": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "operationId": "getF1Standings",
        "summary": "Get Formula 1 championship standings",
        "description": "Returns the Formula 1 championship standings. Use type=drivers (default) or type=constructors.",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "standings",
            "module": "$import(./modules/sports-f1-handler)"
          },
          "policies": {
            "inbound": [
              "mcp-jwt-auth",
              "log-tool-call",
              "rate-limit-tool-call"
            ]
          },
          "mcp": {
            "type": "tool",
            "name": "getF1Standings",
            "description": "Returns the Formula 1 championship standings. Use type=drivers (default) or type=constructors."
          }
        },
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Which championship. Defaults to drivers.",
            "schema": {
              "type": "string",
              "enum": [
                "drivers",
                "constructors"
              ]
            }
          },
          {
            "name": "season",
            "in": "query",
            "required": false,
            "description": "Season year, e.g. 2025. Omit for the current season.",
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/sports/f1/results": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "operationId": "getF1RaceResults",
        "summary": "Get Formula 1 race results",
        "description": "Returns the finishing order of a Formula 1 race. With no parameters, returns the most recent race.",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "raceResults",
            "module": "$import(./modules/sports-f1-handler)"
          },
          "policies": {
            "inbound": [
              "mcp-jwt-auth",
              "log-tool-call",
              "rate-limit-tool-call"
            ]
          },
          "mcp": {
            "type": "tool",
            "name": "getF1RaceResults",
            "description": "Returns the finishing order of a Formula 1 race. With no parameters, returns the most recent race."
          }
        },
        "parameters": [
          {
            "name": "season",
            "in": "query",
            "required": false,
            "description": "Season year, e.g. 2025. Omit for the current season.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "round",
            "in": "query",
            "required": false,
            "description": "Round number within the season, e.g. 5. Omit for the most recent race.",
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/sports/f1/schedule": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "operationId": "getF1Schedule",
        "summary": "Get the Formula 1 race calendar",
        "description": "Returns every race in a Formula 1 season with its round, circuit, location and date. Use it to find the next race or a round number for getF1RaceResults.",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "schedule",
            "module": "$import(./modules/sports-f1-handler)"
          },
          "policies": {
            "inbound": [
              "mcp-jwt-auth",
              "log-tool-call",
              "rate-limit-tool-call"
            ]
          },
          "mcp": {
            "type": "tool",
            "name": "getF1Schedule",
            "description": "Returns every race in a Formula 1 season with its round, circuit, location and date. Use it to find the next race or a round number for getF1RaceResults."
          }
        },
        "parameters": [
          {
            "name": "season",
            "in": "query",
            "required": false,
            "description": "Season year, e.g. 2025. Omit for the current season.",
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/sports/weather": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "operationId": "getVenueWeather",
        "summary": "Get weather for a game's city",
        "description": "Returns current conditions and a 24-hour hourly forecast (°F, mph) for a city, e.g. to check the weather for a game. Pass the venue city from a scoreboard result.",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "default",
            "module": "$import(./modules/sports-weather-handler)"
          },
          "policies": {
            "inbound": [
              "mcp-jwt-auth",
              "log-tool-call",
              "rate-limit-tool-call"
            ]
          },
          "mcp": {
            "type": "tool",
            "name": "getVenueWeather",
            "description": "Returns current conditions and a 24-hour hourly forecast (°F, mph) for a city, e.g. to check the weather for a game. Pass the venue city from a scoreboard result."
          }
        },
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": true,
            "description": "City name, optionally with state or country, e.g. 'Boston', 'Boston, MA' or 'London, GB'.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/sports/mcp": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "post": {
        "operationId": "sports-mcp-server",
        "summary": "Sports MCP Server",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "sports-mcp-server",
              "version": "1.0.0",
              "operations": [
                {
                  "file": "./config/sports.oas.json",
                  "id": "getLeagueScoreboard"
                },
                {
                  "file": "./config/sports.oas.json",
                  "id": "getLeagueStandings"
                },
                {
                  "file": "./config/sports.oas.json",
                  "id": "getLeagueNews"
                },
                {
                  "file": "./config/sports.oas.json",
                  "id": "getF1Standings"
                },
                {
                  "file": "./config/sports.oas.json",
                  "id": "getF1RaceResults"
                },
                {
                  "file": "./config/sports.oas.json",
                  "id": "getF1Schedule"
                },
                {
                  "file": "./config/sports.oas.json",
                  "id": "getVenueWeather"
                }
              ]
            }
          },
          "policies": {
            "inbound": [
              "mcp-jwt-auth"
            ]
          }
        }
      }
    }
  }
}
