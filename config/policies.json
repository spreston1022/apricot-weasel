{
  "policies": [
    {
      "name": "rate-limit-tenant",
      "policyType": "rate-limit-inbound",
      "handler": {
        "export": "RateLimitInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "rateLimitBy": "function",
          "requestsAllowed": 100,
          "timeWindowMinutes": 1,
          "identifier": {
            "export": "rateLimitByTenant",
            "module": "$import(./modules/rate-limit-tenant)"
          }
        }
      }
    },
    {
      "name": "rate-limit-user",
      "policyType": "rate-limit-inbound",
      "handler": {
        "export": "RateLimitInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "rateLimitBy": "function",
          "requestsAllowed": 20,
          "timeWindowMinutes": 1,
          "identifier": {
            "export": "rateLimitByUser",
            "module": "$import(./modules/rate-limit-user)"
          }
        }
      }
    },
    {
      "name": "rate-limit-tool-call",
      "policyType": "rate-limit-inbound",
      "handler": {
        "export": "RateLimitInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "rateLimitBy": "function",
          "requestsAllowed": 5,
          "timeWindowMinutes": 1,
          "identifier": {
            "export": "rateLimitByToolCall",
            "module": "$import(./modules/rate-limit-tool-call)"
          }
        }
      }
    },
    {
      "name": "open-id-jwt-auth-inbound",
      "policyType": "open-id-jwt-auth-inbound",
      "handler": {
        "export": "OpenIdJwtInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "audience": "https://api.yourapp.com",
          "issuer": "https://auth.example.com",
          "secret": "wENfc4Pou8jhpANfckHOYoqsL1fZZ1yS5xyKTYnfVLY="
        }
      }
    },
    {
      "name": "mcp-jwt-auth-builtin-test",
      "policyType": "open-id-jwt-auth-inbound",
      "handler": {
        "export": "OpenIdJwtInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "audience": "apricot-weasel-mcp",
          "issuer": "https://apricot-weasel-main-fc6ace1.zuplo.app",
          "jwkUrl": "https://apricot-weasel-main-fc6ace1.zuplo.app/.well-known/jwks.json"
        }
      }
    },
    {
      "name": "jwt-scopes-inbound",
      "policyType": "jwt-scopes-inbound",
      "handler": {
        "export": "JWTScopeValidationInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "scopes": ["plan:premium"]
        }
      }
    },
    {
      "name": "open-id-jwt-auth-inbound-1",
      "policyType": "open-id-jwt-auth-inbound",
      "handler": {
        "export": "OpenIdJwtInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "audience": "https://api.yourapp.com",
          "issuer": "https://auth.example.com",
          "secret": "wENfc4Pou8jhpANfckH0YoqsL1fZZ1yS5xyKTYnfVLY="
        }
      }
    },
    {
      "name": "jwt-scopes-inbound-1",
      "policyType": "jwt-scopes-inbound",
      "handler": {
        "export": "JWTScopeValidationInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "scopes": ["read:payments", "write:payments"]
        }
      }
    },
    {
      "name": "api-key-inbound",
      "policyType": "api-key-inbound",
      "handler": {
        "export": "ApiKeyInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "allowUnauthenticatedRequests": false,
          "cacheTtlSeconds": 60
        }
      }
    },
    {
      "name": "log-tool-call",
      "policyType": "custom-code-inbound",
      "handler": {
        "export": "default",
        "module": "$import(./modules/log-tool-call)"
      }
    },
    {
      "name": "mcp-jwt-auth-inbound",
      "policyType": "custom-code-inbound",
      "handler": {
        "export": "default",
        "module": "$import(./modules/mcp-jwt-auth-inbound)"
      }
    },
    {
      "name": "set-espn-user-agent",
      "policyType": "set-headers-inbound",
      "handler": {
        "export": "SetHeadersInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "headers": [
            {
              "name": "user-agent",
              "value": "Zuplo-MLB-Gateway/1.0",
              "overwrite": true
            }
          ]
        }
      }
    },
    {
      "name": "add-apisports-key",
      "policyType": "set-headers-inbound",
      "handler": {
        "export": "SetHeadersInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "headers": [
            {
              "name": "x-apisports-key",
              "value": "a337d360c36aa11e4465d2fac96de6fb",
              "overwrite": true
            }
          ]
        }
      }
    }
  ]
}