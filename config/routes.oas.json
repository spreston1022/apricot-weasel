{
  "openapi": "3.1.0",
  "info": {
    "title": "ESPN MLB API",
    "version": "1.0.0",
    "description": "MLB data via ESPN's unofficial public API — no API key required"
  },
  "paths": {
    "/standings": {
      "x-zuplo-path": { "pathMode": "open-api" },
      "get": {
        "operationId": "getStandings",
        "summary": "Get MLB standings",
        "description": "Returns current MLB standings for all divisions. No parameters required — always returns current season standings.",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "https://site.api.espn.com/apis/v2/sports/baseball/mlb"
            }
          },
          "policies": { "inbound": [] }
        }
      }
    },
    "/scoreboard": {
      "x-zuplo-path": { "pathMode": "open-api" },
      "get": {
        "operationId": "getScoreboard",
        "summary": "Get MLB scoreboard",
        "description": "Returns today's MLB games with live scores. Use dates parameter (YYYYMMDD) to get games for a specific date.",
        "parameters": [
          {
            "name": "dates",
            "in": "query",
            "required": false,
            "description": "Date in YYYYMMDD format, e.g. 20250401. Omit for today's games.",
            "schema": { "type": "string" }
          }
        ],
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "https://site.api.espn.com/apis/site/v2/sports/baseball/mlb"
            }
          },
          "policies": { "inbound": [] }
        }
      }
    },
    "/teams": {
      "x-zuplo-path": { "pathMode": "open-api" },
      "get": {
        "operationId": "getTeams",
        "summary": "Get MLB teams",
        "description": "Returns all MLB teams with basic information.",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "https://site.api.espn.com/apis/site/v2/sports/baseball/mlb"
            }
          },
          "policies": { "inbound": [] }
        }
      }
    },
    "/news": {
      "x-zuplo-path": { "pathMode": "open-api" },
      "get": {
        "operationId": "getNews",
        "summary": "Get MLB news",
        "description": "Returns the latest MLB news and headlines.",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "https://site.api.espn.com/apis/site/v2/sports/baseball/mlb"
            }
          },
          "policies": { "inbound": [] }
        }
      }
    },
    "/mcp": {
      "x-zuplo-path": { "pathMode": "open-api" },
      "post": {
        "operationId": "mcp-server",
        "summary": "MCP Server",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "mlb-mcp-server",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "getStandings" },
                { "file": "./config/routes.oas.json", "id": "getScoreboard" },
                { "file": "./config/routes.oas.json", "id": "getTeams" },
                { "file": "./config/routes.oas.json", "id": "getNews" }
              ]
            }
          },
          "policies": { "inbound": [] }
        }
      }
    }
  }
}